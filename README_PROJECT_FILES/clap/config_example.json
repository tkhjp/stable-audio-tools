{
    "use_clap": true,
    "use_passt": true,
    "use_generation": true,
    
    "clap_model_name": "laion/clap-htsat-unfused",
    
    "dit_config": "/path/to/your/diffusion_model_config.json",
    "vae_config": "/path/to/your/autoencoder_model_config.json",
    "dit_checkpoint": "/path/to/your/dit_model.ckpt",
    "vae_checkpoint": "/path/to/your/vae_model.ckpt",
    
    "reference_audio_dir": "/path/to/reference/audio/files",
    
    "generation_params": {
        "duration": 10.0,
        "steps": 50,
        "cfg_scale": 6,
        "sigma_min": 0.03,
        "sigma_max": 1000.0,
        "sampler_type": "dpmpp-3m-sde"
    },
    
    "openl3_params": {
        "input_repr": "mel128",
        "content_type": "env",
        "embedding_size": 512,
        "hop_size": 0.1
    },
    
    "passt_params": {
        "batch_size": 8,
        "target_sr": 32000
    }
} 